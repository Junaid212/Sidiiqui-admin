# ── Server ───────────────────────────────────────────────────────────
PORT=5001

# ── Frontend URL (production domain) ─────────────────────────────────
# Used as server-side fallback for password reset email links
FRONTEND_URL=https://admin.siddiqui.digital

# ── Supabase ─────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# ── SMTP (iPage) ──────────────────────────────────────────────────────
SMTP_HOST=smtp.ipage.com
SMTP_PORT=587
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=your-smtp-password
# SMTP_FROM must be a full RFC 5321 address, e.g.:
SMTP_FROM="Your Brand <info@yourdomain.com>"
ADMIN_EMAIL=info@yourdomain.com
