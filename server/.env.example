# ── Server ───────────────────────────────────────────────────────────
PORT=5001

# ── Frontend URL (production domain) ─────────────────────────────────
# Used as server-side fallback for password reset email links
FRONTEND_URL=https://admin.siddiqui.digital

# ── Supabase ─────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# ── SMTP (iPage) ──────────────────────────────────────────────────────
SMTP_HOST=smtp.ipage.com
SMTP_PORT=587
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=your-smtp-password
# SMTP_FROM must be a full RFC 5321 address, e.g.:
SMTP_FROM="Your Brand <info@yourdomain.com>"
ADMIN_EMAIL=info@yourdomain.com

# ── Public share-preview pages (optional; this feature is OFF unless PUBLIC_SITE_ROOT is set) ──
# Folder that nginx serves for https://siddiqui.digital (it contains index.html and the blogs/ folder).
# After every article save the admin server rewrites <PUBLIC_SITE_ROOT>/blogs/<slug>/index.html.
# The user that runs the admin process (PM2) must have write permission on this folder.
# PUBLIC_SITE_ROOT=/var/www/frontend
# Minutes between automatic re-checks of every page (retries failures, publishes scheduled articles when due). 0 = off.
# PRERENDER_SWEEP_MINUTES=15
